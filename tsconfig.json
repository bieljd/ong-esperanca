{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "rootDir": "assets/js",
    "outDir": "assets/js/dist",
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "sourceMap": true,
    "removeComments": false,
    "lib": ["ES2020", "DOM", "DOM.Iterable"]
  },
  "include": ["assets/js/**/*.ts"],
  "exclude": ["assets/js/dist"]
}
